# Postgres connection (Supabase: use the pooled "Transaction" connection string)
DATABASE_URL=postgres://user:password@host:5432/motorna
# 32+ random bytes: `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Public origin of the app
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Image storage: "local" (dev only) or "s3" (Supabase Storage S3 endpoint, R2, AWS…)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage/uploads
# Supabase example:
# S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
# S3_REGION=eu-central-1
# S3_BUCKET=media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=https://<project-ref>.supabase.co/storage/v1/object/public/media

# Email: "console" (dev: logs links to the server console). Production provider not wired yet.
EMAIL_PROVIDER=console

# Phase 2 (not used yet)
# ANTHROPIC_API_KEY=
# Private bucket for MOTORNA Care credential documents (S3 driver)
S3_PRIVATE_BUCKET=
# Local driver: where private documents are stored (outside the public media dir)
STORAGE_PRIVATE_DIR=./storage/private
